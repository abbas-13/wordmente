# Dependencies
node_modules/

# Build output
dist/
.vite/

# Test output
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Local environment and secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
.npmrc

# Editor and OS cruft
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
# ...but share the formatting config, so every clone formats the same way.
# The directory-contents form above is required: git cannot re-include a file
# whose parent directory is excluded.
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*~

# Local overrides
*.local

# Reverse-engineering scratch (bundles, page dumps, triage output)
.recon/
